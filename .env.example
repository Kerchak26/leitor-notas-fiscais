# Servidor IMAP (Gmail: imap.gmail.com | Outlook: outlook.office365.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USUARIO=seu.email@gmail.com
# No Gmail use uma "Senha de app" (https://myaccount.google.com/apppasswords)
EMAIL_SENHA=sua_senha_de_app

# Pasta da caixa de e-mail a ser lida
EMAIL_PASTA=INBOX
# Só lê e-mails enviados por estes endereços (separados por vírgula). Ex.: o e-mail do seu chefe.
# Vazio = qualquer remetente.
FILTRO_REMETENTE=chefe@empresa.com.br
# Só lê e-mails cujo assunto contenha uma destas palavras (separadas por vírgula). Vazio = todos.
# E-mails encaminhados ("ENC:", "Fwd:") nem sempre têm "nota" no assunto; se usar o
# filtro de remetente, pode deixar este vazio.
FILTRO_ASSUNTO=
# Ler apenas e-mails a partir desta data (DD/MM/AAAA). Vazio = sem limite.
DATA_INICIO=
# Marcar os e-mails processados como lidos (true/false)
MARCAR_COMO_LIDO=false

# Saídas
PASTA_ANEXOS=dados/anexos
ARQUIVO_SAIDA=dados/notas_fiscais.xlsx
